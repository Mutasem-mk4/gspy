# Maintainer: Mutasem Kharma <mutasem@gspy.dev>
# SPDX-License-Identifier: GPL-2.0-only
pkgname=gspy
pkgver=0.2.2
pkgrel=1
_commit=5b82ec99f8d529a0ee68e35ddf5e59b498edef4d
pkgdesc="Forensic goroutine-to-syscall inspector for live Go processes using eBPF."
arch=('x86_64' 'aarch64')
url="https://github.com/Mutasem-mk4/gspy"
license=('GPL-2.0-only')
groups=('blackarch' 'blackarch-forensic' 'blackarch-debugger')
makedepends=('go>=1.26.8' 'clang>=14' 'llvm>=14' 'libbpf' 'linux-api-headers')
source=("$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('9705f8065457ad9b499aebbfc8485db862340161d47f605a40d404170c353624')

build() {
    cd "$pkgname-$_commit"
    export CGO_ENABLED=0
    export GOFLAGS="-mod=readonly -modcacherw -buildvcs=false"
    make build VERSION="$pkgver"
}

check() {
    cd "$pkgname-$_commit"
    go test -tags=testing ./...
}

package() {
    cd "$pkgname-$_commit"
    install -Dm755 bin/gspy "$pkgdir/usr/bin/gspy"
    install -Dm644 man/gspy.1 "$pkgdir/usr/share/man/man1/gspy.1"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
